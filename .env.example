# ============================================================================
# ExplanationLab — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# --- Database -----------------------------------------------------------------
# Postgres (docker compose default):
DATABASE_URL=postgresql+psycopg://explab:explab@localhost:5432/explanationlab
# Zero-dependency local fallback (no Docker needed):
# DATABASE_URL=sqlite+pysqlite:///./explanationlab.sqlite3

# --- Provider credentials (server-side only; never exposed to the browser) ----
# Leave BOTH blank to run in DEMO MODE (fixture responses, clearly labelled
# synthetic, no API calls, no spend).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Researcher authentication ------------------------------------------------
# Bearer token required by every /api/* route except participant + health routes.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank, auth is DISABLED and the API binds to localhost only (local-dev mode).
RESEARCHER_API_TOKEN=
EXPLAB_ALLOW_INSECURE_LOCAL=true

# --- Cost + safety controls ---------------------------------------------------
MAX_BATCH_REQUESTS=120                # hard ceiling on model calls per experiment
COST_CONFIRMATION_THRESHOLD_USD=1.00  # batches above this need explicit confirmation
DAILY_SPEND_CAP_USD=25.00             # worker refuses new calls past this
PROVIDER_TIMEOUT_SECONDS=180
PROVIDER_MAX_RETRIES=2
MAX_INPUT_CHARS=24000                 # input limit on questions / imported answers
ENABLE_RESPONSE_CACHE=true

# --- Job execution ------------------------------------------------------------
RUN_WORKER_IN_API=true                # false => run `python -m explanationlab.jobs.worker`
WORKER_CONCURRENCY=3

# --- Frontend -----------------------------------------------------------------
# Used by the Next.js server-side proxy. The browser never sees the token.
API_BASE_URL=http://localhost:8000
